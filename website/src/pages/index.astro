---
import Base from "../layouts/Base.astro";
import AppFrame from "../components/AppFrame.astro";
import { AndromedaField } from "../components/AndromedaField";
import "../components/Hero.css";
import {
  slogan,
  repoUrl,
  version,
  shaleLicense,
  downloads,
  downloadUrl,
  checksumsUrl,
  releasePageUrl,
  primaryDownload,
  features,
  comingNext,
  mediaSlots,
  mcpEnvExample,
  underTheHood,
  launchStatLine,
} from "../config/site";

const windowsCli = downloads.find((d) => d.id === "windows-cli");
const linuxCli = downloads.find((d) => d.id === "linux-cli");

const mcpJson = JSON.stringify(
  {
    mcpServers: {
      shale: {
        command: "/usr/local/bin/shale-mcp",
        env: { ...mcpEnvExample },
      },
    },
  },
  null,
  2,
);

function bentoClass(span: "normal" | "wide") {
  return span === "wide" ? "bento-item--span-3" : "bento-item--span-2";
}
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-field">
      <AndromedaField client:visible />
    </div>
    <div class="wrap hero-inner">
      <p class="eyebrow hero-kicker">Bambu Lab only · v{version}</p>
      <h1 id="hero-title">Shale</h1>
      <div class="hero-tagline-wrap">
        <p class="slogan-display slogan-display--hero" data-reveal>{slogan}</p>
      </div>
      <p class="hero-lede">
        A calm slicer for Bambu Lab printers — built on unmodified CuraEngine, with
        Bambu Studio presets, account sign-in, and a workspace that stays out of your way.
      </p>
      <p class="hero-stat" role="status">{launchStatLine()}</p>
      <p class="hero-under">
        <span class="dim">Under the hood:</span> {underTheHood}
      </p>
      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href={downloadUrl(primaryDownload.fileName)}
        >
          Download for Windows
        </a>
        <a class="btn btn-ghost" href="#downloads">CLI + MCP packages</a>
        <a class="btn btn-ghost" href={repoUrl}>View on GitHub</a>
      </div>
      <p class="hero-meta">
        Windows installer · .shale projects · no trackers on this site
      </p>
    </div>
  </section>

  <section id="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Features</p>
        <h2 id="features-title">Built for how you already print</h2>
        <p>
          Account, presets, send, and headless tools — everything in v{version} is aimed at
          Bambu workflows, not a generic printer list.
        </p>
      </div>
      <div class="bento">
        {
          features.map((f, i) => (
            <article
              class:list={[
                "card",
                "bento-item",
                bentoClass(f.span),
                f.id === "fast" && "bento-item--row-2",
              ]}
              data-reveal
              data-reveal-delay={(i % 3) + 1}
            >
              <span class="bento-kicker" aria-hidden="true" />
              <h3>{f.title}</h3>
              <p class="muted">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="media" aria-labelledby="media-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">App</p>
        <h2 id="media-title">The real workspace</h2>
        <p>
          Prepare, preview, and device send — framed like the window you open on your machine.
          Drop more stills into <code class="mono">website/public/media/</code> when you have them.
        </p>
      </div>
      <div class="media-bento">
        {
          mediaSlots.map((m, i) => {
            const layoutClass =
              m.layout === "hero"
                ? "media-bento-item--hero"
                : m.layout === "tall"
                  ? "media-bento-item--tall"
                  : "";
            return (
              <figure
                class:list={["media-bento-item", layoutClass]}
                data-reveal
                data-reveal-delay={(i % 2) + 1}
              >
                {m.kind === "video" ? (
                  <AppFrame title="Shale — promo">
                    <div class="media-placeholder" role="img" aria-label={m.alt}>
                      <span class="badge">Video slot</span>
                    </div>
                  </AppFrame>
                ) : (
                  <AppFrame title={`Shale — ${m.id}`}>
                    <img
                      src={m.src}
                      alt={m.alt}
                      loading="lazy"
                      width="960"
                      height="540"
                      decoding="async"
                    />
                  </AppFrame>
                )}
                <figcaption class="media-caption">{m.caption}</figcaption>
              </figure>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="downloads" aria-labelledby="downloads-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Download</p>
        <h2 id="downloads-title">v{version} release assets</h2>
        <p>
          Shale {version} on <a href={releasePageUrl}>GitHub Releases</a>: the Windows installer
          and the headless packages. Verify downloads against{" "}
          <a href={checksumsUrl}>SHA256SUMS.txt</a>.
        </p>
      </div>
      <div class="download-grid">
        {
          downloads.map((d, i) => (
            <article
              class="card download-card"
              data-reveal
              data-reveal-delay={(i % 3) + 1}
            >
              <h3>{d.title}</h3>
              <p class="muted">{d.description}</p>
              <p class="mono dim file-name">{d.fileName}</p>
              <dl class="checksums">
                {
                  d.sizeLabel && (
                    <div>
                      <dt>Size</dt>
                      <dd>{d.sizeLabel}</dd>
                    </div>
                  )
                }
                <div>
                  <dt>SHA-256</dt>
                  <dd class="sha">
                    {d.sha256 ? (
                      d.sha256
                    ) : (
                      <a href={checksumsUrl}>SHA256SUMS.txt</a>
                    )}
                  </dd>
                </div>
              </dl>
              <a class="btn btn-primary" href={downloadUrl(d.fileName)}>
                Download
              </a>
            </article>
          ))
        }
      </div>

      <div class="cli-docs card cli-scroll" style="margin-top: 1.5rem;" data-reveal>
        <h3>Headless install</h3>
        <p class="muted">
          From <a href={`${repoUrl}/blob/main/docs/INSTALL-CLI.md`}>docs/INSTALL-CLI.md</a>.
          Point at CuraEngine and the resource tree at run time.
        </p>
        {
          windowsCli && (
            <div>
              <h4>Windows</h4>
              <p class="muted">
                Unzip <code class="mono">{windowsCli.fileName}</code> anywhere and run from that
                folder:
              </p>
              <pre>{`Expand-Archive .\\${windowsCli.fileName} -DestinationPath .\\shale-cli
cd shale-cli
.\\shale-cli.exe info
.\\shale-cli.exe printers --search a1
.\\shale-cli.exe slice .\\cube.stl --printer bambu_lab_a1 --layer 0.2 --infill 20 -o .\\cube.gcode`}</pre>
            </div>
          )
        }
        {
          linuxCli && (
            <>
              <h4>Linux</h4>
              <p class="muted">
                Extract <code class="mono">{linuxCli.fileName}</code>, then install (Debian example):
              </p>
              <pre>{`tar -xzf ${linuxCli.fileName}
cd shale-${version}-linux-x64
sudo install -m755 shale-cli shale-mcp /usr/local/bin/
shale-cli info`}</pre>
              <pre>{`export SHALE_CURAENGINE=/usr/bin/CuraEngine
export SHALE_CURA_DIR=/usr/share/cura/resources
export SHALE_MATERIALS_DIR=/usr/share/cura/resources/materials`}</pre>
            </>
          )
        }

        <h4>MCP client</h4>
        <p class="muted">
          Stdio is what most clients expect — same JSON shape as Claude Desktop in the repo docs.
          Loopback HTTP: <code class="mono">shale-mcp --http 127.0.0.1:PORT</code>.
        </p>
        <pre class="cli-scroll"><code>{mcpJson}</code></pre>
      </div>
    </div>
  </section>

  <section id="coming" aria-labelledby="coming-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Roadmap</p>
        <h2 id="coming-title">Coming next</h2>
        <p>Planned after v0.1 — not in this build.</p>
      </div>
      <div class="bento">
        {
          comingNext.map((item, i) => (
            <article
              class="card bento-item bento-item--span-2"
              data-reveal
              data-reveal-delay={(i % 3) + 1}
            >
              <span class="badge">{item.status}</span>
              <h3 style="margin-top: 0.75rem;">{item.title}</h3>
              <p class="muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing-slogan" aria-label="Closing">
    <div class="wrap">
      <p class="slogan-display" data-reveal>{slogan}</p>
    </div>
  </section>

  <footer class="site-footer" slot="footer">
    <div class="wrap">
      <p>
        <a href={repoUrl}>Shale on GitHub</a> — source, issues, and release assets.
      </p>
      <p class="dim">Licence notes</p>
      <ul>
        <li>
          <strong>CuraEngine</strong> — AGPL-3.0. Shale starts it as a separate process; you
          provide the binary.
        </li>
        <li>
          <strong>Bambu Studio profiles</strong> — read as data from an installed Bambu Studio
          tree (AGPL-3.0 applies to that upstream material).
        </li>
        <li>
          <strong>Shale itself</strong> — {shaleLicense} (see
          <a href={`${repoUrl}/blob/main/LICENSING.md`}>LICENSING.md</a>).
        </li>
      </ul>
      <p class="dim mono" style="margin-top: 1.5rem;">
        Hero: ASCII Andromeda (NASA GALEX M31), same reference as the app.
      </p>
    </div>
  </footer>
</Base>

<style>
  .cli-docs h3,
  .cli-docs h4 {
    font-size: 1.02rem;
    margin: 1.15rem 0 0.45rem;
    font-weight: 600;
  }

  .cli-docs h3:first-child {
    margin-top: 0;
  }

  .bento-item h3 {
    font-size: 1.08rem;
  }
</style>