---
import Base from "../layouts/Base.astro";
import Sha256Field from "../components/Sha256Field.astro";
import "../components/Hero.css";
import { FieldThemePicker } from "../components/demos/FieldThemePicker";
import HeroPrintSceneRoot from "../components/demos/HeroPrintSceneRoot";
import DemoWorkbench from "../components/demos/DemoWorkbench";
import {
  slogan,
  repoUrl,
  version,
  shaleLicense,
  downloads,
  downloadUrl,
  checksumsUrl,
  releasePageUrl,
  primaryDownload,
  launchBenchmarks,
} from "../config/site";
---

<Base preloadImage="/media/prepare-hero-1200.webp">
  <div class="page-bed" aria-hidden="true"></div>

  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-shell">
      <div class="hero-copy">
        <h1 id="hero-title">Shale</h1>
        <p class="hero-line">{slogan}</p>
        <p class="hero-deck">
          Bambu-only slicer on CuraEngine — sign in, slice with Studio presets, send when you are
          ready.
        </p>
        <FieldThemePicker client:load />
        <ul class="hero-stats" aria-label="Launch benchmarks">
          <li class="hero-stat-item">
            <span class="hero-stat-value"
              >{launchBenchmarks.shaleUsableWarmSeconds}<span class="unit">s</span></span
            >
            <span class="hero-stat-label">Warm</span>
          </li>
          <li class="hero-stat-item">
            <span class="hero-stat-value"
              >{launchBenchmarks.shaleUsableColdSeconds}<span class="unit">s</span></span
            >
            <span class="hero-stat-label">Cold</span>
          </li>
          <li class="hero-stat-item">
            <span class="hero-stat-value">{launchBenchmarks.competitorRangeLabel}</span>
            <span class="hero-stat-label">Typical slicers</span>
          </li>
        </ul>
        <div class="hero-actions">
          <a class="btn btn-primary" href={downloadUrl(primaryDownload.fileName)}>
            Download for Windows
          </a>
          <a class="hero-secondary" href="#downloads">All packages</a>
        </div>
        <p class="hero-meta dim">v{version} · {shaleLicense}</p>
      </div>
      <div class="hero-demo" data-reveal>
        <HeroPrintSceneRoot client:visible />
      </div>
    </div>
  </section>

  <section id="demos" aria-labelledby="demos-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow section-eyebrow">Workbench</p>
        <h2 id="demos-title">Slice, catalogue, connect</h2>
        <p class="muted">
          Interactive previews below — illustrative toolpaths from <code>examples/t-wing.stl</code>, scripted
          CLI/MCP, and Bambu catalogue data from v0.1.3. Nothing here starts a print.
        </p>
      </div>
      <DemoWorkbench client:visible />
    </div>
  </section>

  <section id="downloads" class="section-downloads" aria-labelledby="downloads-title">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div class="section-head--lead">
          <h2 id="downloads-title">Get Shale {version}</h2>
        </div>
        <p class="muted section-head-dek">
          <a href={releasePageUrl}>GitHub Releases</a> · <a href={checksumsUrl}>SHA256SUMS.txt</a>
        </p>
      </div>
      <div class="download-grid">
        {
          downloads.map((d, i) => (
            <article class="panel download-card" data-reveal data-reveal-delay={(i % 3) + 1}>
              <h3>{d.title}</h3>
              <p class="muted">{d.description}</p>
              <p class="mono dim file-name">{d.fileName}</p>
              <dl class="checksums">
                {
                  d.sizeLabel && (
                    <div>
                      <dt>Size</dt>
                      <dd>{d.sizeLabel}</dd>
                    </div>
                  )
                }
                <div>
                  <dt>SHA-256</dt>
                  <dd>
                    <Sha256Field hash={d.sha256} checksumsUrl={checksumsUrl} />
                  </dd>
                </div>
              </dl>
              <a class="btn btn-primary" href={downloadUrl(d.fileName)}>
                Download
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="site-footer" slot="footer">
    <div class="wrap">
      <p>
        <a href={repoUrl}>Shale on GitHub</a>
      </p>
      <ul>
        <li>
          <strong>CuraEngine</strong> — AGPL-3.0
        </li>
        <li>
          <strong>Shale</strong> — {shaleLicense}
        </li>
      </ul>
    </div>
  </footer>
</Base>