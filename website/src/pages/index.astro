---
import Base from "../layouts/Base.astro";
import { AndromedaField } from "../components/AndromedaField";
import { SloganReveal } from "../components/SloganReveal";
import "../components/Hero.css";
import {
  slogan,
  repoUrl,
  version,
  shaleLicense,
  downloads,
  downloadUrl,
  primaryDownload,
  features,
  comingNext,
  mediaSlots,
  mcpEnvExample,
  underTheHood,
  launchStatLine,
} from "../config/site";

const windowsCli = downloads.find((d) => d.id === "windows-cli");
const linuxCli = downloads.find((d) => d.id === "linux-cli");

const mcpJson = JSON.stringify(
  {
    mcpServers: {
      shale: {
        command: "/usr/local/bin/shale-mcp",
        env: { ...mcpEnvExample },
      },
    },
  },
  null,
  2,
);
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-field">
      <AndromedaField client:load />
    </div>
    <div class="wrap hero-inner">
      <p class="hero-kicker">Bambu Lab only · v{version}</p>
      <h1 id="hero-title">Shale</h1>
      <div class="hero-tagline-wrap">
        <SloganReveal text={slogan} className="hero-slogan" immediate client:load />
      </div>
      <p class="hero-lede">
        A slicer that looks as good as it prints. Sign in with your Bambu account,
        manage your printers, and slice with Bambu Studio's presets.
      </p>
      <p class="hero-stat">{launchStatLine()}</p>
      <p class="hero-under">
        <span class="dim">Under the hood:</span> {underTheHood}
      </p>
      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href={downloadUrl(primaryDownload.fileName)}
        >
          Download for Windows
        </a>
        <a class="btn btn-ghost" href="#downloads">CLI + MCP packages</a>
        <a class="btn btn-ghost" href={repoUrl}>View on GitHub</a>
      </div>
      <p class="hero-meta">
        Windows installer · .shale projects · no trackers on this site
      </p>
    </div>
  </section>

  <section id="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="features-title">Why Shale</h2>
        <p>
          Not a science project — the things you would switch slicers for, shipping in
          v0.1.
        </p>
      </div>
      <div class="grid-3">
        {
          features.map((f, i) => (
            <article class="card" data-reveal data-reveal-delay={(i % 3) + 1}>
              <span class="feature-icon" aria-hidden="true">
                {f.icon}
              </span>
              <h3>{f.title}</h3>
              <p class="muted">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="media" aria-labelledby="media-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="media-title">See it in the window</h2>
        <p>
          Prepare, preview and device send — captured from the real app. Drop more
          stills or a short promo into <code class="mono">website/public/media/</code>
          when you have them.
        </p>
      </div>
      <div class="grid-2 media-grid">
        {
          mediaSlots.map((m, i) =>
            m.kind === "video" ? (
              <figure
                class="card media-card media-card--placeholder"
                data-reveal
                data-reveal-delay={(i % 2) + 1}
              >
                <div class="media-placeholder" role="img" aria-label={m.alt}>
                  <span class="badge">Video slot</span>
                </div>
                <figcaption>{m.caption}</figcaption>
              </figure>
            ) : (
              <figure class="card media-card" data-reveal data-reveal-delay={(i % 2) + 1}>
                <img
                  src={m.src}
                  alt={m.alt}
                  loading="lazy"
                  width="960"
                  height="540"
                />
                <figcaption class="muted">{m.caption}</figcaption>
              </figure>
            ),
          )
        }
      </div>
    </div>
  </section>

  <section id="downloads" aria-labelledby="downloads-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="downloads-title">Download</h2>
        <p>
          GitHub Releases hosts the installer and headless packages. Update checksums
          and sizes in <code class="mono">src/config/site.ts</code> when you publish.
        </p>
      </div>
      <div class="grid-3 download-grid">
        {
          downloads.map((d, i) => (
            <article class="card download-card" data-reveal data-reveal-delay={(i % 3) + 1}>
              <h3>{d.title}</h3>
              <p class="muted">{d.description}</p>
              <p class="mono dim file-name">{d.fileName}</p>
              <dl class="checksums">
                <div>
                  <dt>Size</dt>
                  <dd>{d.sizeLabel}</dd>
                </div>
                <div>
                  <dt>SHA-256</dt>
                  <dd class="sha">{d.sha256}</dd>
                </div>
              </dl>
              <a class="btn btn-primary" href={downloadUrl(d.fileName)}>
                Download
              </a>
            </article>
          ))
        }
      </div>

      <div class="cli-docs card cli-scroll" style="margin-top: 2rem;" data-reveal>
        <h3>Headless install</h3>
        <p class="muted">
          From <a href={`${repoUrl}/blob/main/docs/INSTALL-CLI.md`}>docs/INSTALL-CLI.md</a>.
          Point at CuraEngine and the resource tree at run time.
        </p>
        {
          windowsCli && (
            <div>
              <h4>Windows</h4>
              <p class="muted">
                Unzip <code class="mono">{windowsCli.fileName}</code> anywhere and run from
                that folder:
              </p>
              <pre>{`Expand-Archive .\\${windowsCli.fileName} -DestinationPath .\\shale-cli
cd shale-cli
.\\shale-cli.exe info
.\\shale-cli.exe printers --search a1
.\\shale-cli.exe slice .\\cube.stl --printer bambu_lab_a1 --layer 0.2 --infill 20 -o .\\cube.gcode`}</pre>
            </div>
          )
        }
        {
          linuxCli && (
            <>
              <h4>Linux</h4>
              <p class="muted">
                Extract <code class="mono">{linuxCli.fileName}</code>, then install (Debian
                example):
              </p>
              <pre>{`tar -xzf ${linuxCli.fileName}
cd shale-${version}-linux-x64
sudo install -m755 shale-cli shale-mcp /usr/local/bin/
shale-cli info`}</pre>
              <pre>{`export SHALE_CURAENGINE=/usr/bin/CuraEngine
export SHALE_CURA_DIR=/usr/share/cura/resources
export SHALE_MATERIALS_DIR=/usr/share/cura/resources/materials`}</pre>
            </>
          )
        }

        <h4>MCP client</h4>
        <p class="muted">
          Stdio is what most clients expect — same JSON shape as Claude Desktop in the
          repo docs. Loopback HTTP:
          <code class="mono">shale-mcp --http 127.0.0.1:PORT</code>.
        </p>
        <pre class="cli-scroll"><code>{mcpJson}</code></pre>
      </div>
    </div>
  </section>

  <section id="coming" aria-labelledby="coming-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="coming-title">Coming next</h2>
        <p>Planned after v0.1 — not in this build.</p>
      </div>
      <div class="grid-3">
        {
          comingNext.map((item, i) => (
            <article class="card" data-reveal data-reveal-delay={(i % 3) + 1}>
              <span class="badge">{item.status}</span>
              <h3 style="margin-top: 0.75rem;">{item.title}</h3>
              <p class="muted">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing-slogan" aria-label="Closing">
    <div class="wrap">
      <SloganReveal text={slogan} as="h2" client:visible />
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap">
      <p>
        <a href={repoUrl}>Shale on GitHub</a> — source, issues and release assets.
      </p>
      <p class="dim">Licence notes</p>
      <ul>
        <li>
          <strong>CuraEngine</strong> — AGPL-3.0. Shale starts it as a separate
          process; you provide the binary.
        </li>
        <li>
          <strong>Bambu Studio profiles</strong> — read as data from an installed
          Bambu Studio tree (AGPL-3.0 applies to that upstream material).
        </li>
        <li>
          <strong>Shale itself</strong> — {shaleLicense} (see
          <a href={`${repoUrl}/blob/main/LICENSING.md`}>LICENSING.md</a>).
        </li>
      </ul>
      <p class="dim mono" style="margin-top: 1.5rem;">
        Hero: ASCII Andromeda (NASA GALEX M31), same reference as the app.
      </p>
    </div>
  </footer>
</Base>

<style>
  .media-grid img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: calc(var(--radius) - 2px);
    border: 1px solid var(--line);
  }

  .media-card {
    margin: 0;
  }

  .media-card figcaption {
    margin-top: 0.85rem;
    font-size: 0.92rem;
  }

  .media-placeholder {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background: #04050a;
    border: 1px dashed var(--line);
    border-radius: calc(var(--radius) - 2px);
  }

  .download-card h3 {
    margin-top: 0;
  }

  .file-name {
    font-size: 0.82rem;
    word-break: break-all;
  }

  .checksums {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 1.25rem;
    font-size: 0.88rem;
  }

  .checksums div {
    display: grid;
    gap: 0.15rem;
  }

  .checksums dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }

  .checksums dd {
    margin: 0;
    color: var(--ink-2);
  }

  .sha {
    font-family: var(--mono);
    font-size: 0.72rem;
    word-break: break-all;
  }

  .cli-docs h3,
  .cli-docs h4 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.5rem;
  }

  .cli-docs h3:first-child {
    margin-top: 0;
  }

  article.card h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }

  article.card p {
    margin: 0;
  }

</style>