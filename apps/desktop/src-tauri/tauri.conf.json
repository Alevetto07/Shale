{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shale",
  "mainBinaryName": "Shale",
  "version": "0.1.3",
  "identifier": "dev.shale.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shale",
      "decorations": false,
        "backgroundColor": "#06070b",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "shortDescription": "The last slicer you'll ever download.",
    "longDescription": "Shale is a desktop 3D-printing slicer for Bambu Lab printers — prepare, slice, preview and send from one window.",
    "copyright": "Copyright © Alessio",
    "active": true,
    "fileAssociations": [
      {
        "ext": ["shale"],
        "name": "Shale project",
        "description": "Shale project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "headerImage": "windows/nsis/header.bmp",
        "sidebarImage": "windows/nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Shale",
        "customLanguageFiles": {
          "English": "windows/nsis/English.nsh"
        }
      }
    },
    "targets": ["deb", "appimage", "nsis", "app", "dmg"],
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
